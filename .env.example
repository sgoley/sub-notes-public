# PocketBase admin account (change before exposing the admin UI)
PB_ADMIN_EMAIL=admin@localhost.local
PB_ADMIN_PASSWORD=change-this-password

# YouTube Data API key is used for video and playlist metadata.
YOUTUBE_API_KEY=your-youtube-api-key

# Choose one provider and configure its key. The selected key stays on the backend.
# Gemini: use LLM_PROVIDER=gemini and set GEMINI_API_KEY.
# OpenRouter: use LLM_PROVIDER=openrouter and set OPENROUTER_API_KEY.
LLM_PROVIDER=gemini
# Optional: defaults to a model for the selected provider.
LLM_MODEL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenRouter endpoint metadata.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_APP_NAME=Sub Notes

# Obsidian vault sync (optional)
OBSIDIAN_VAULT_PATH=/path/to/your/vault
OBSIDIAN_SUBFOLDER=sub-notes
